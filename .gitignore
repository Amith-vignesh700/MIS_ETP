# ============================================================
# .gitignore — Ultrasound Elastography for Label-Free Tumor Grading
# ============================================================

# ── Datasets (NEVER commit .mat files — they are multi-GB) ───────────────────
data/
*.mat
*.MAT

# ── Trained Model Weights (too large for git; use git-lfs or cloud storage) ──
backend/ml_engine/weights/*.pth
backend/ml_engine/weights/*.pt
backend/ml_engine/weights/*.ckpt
# Keep the placeholder so the weights/ directory exists in the repo
!backend/ml_engine/weights/.gitkeep

# ── Python Virtual Environments ───────────────────────────────────────────────
venv/
.venv/
env/
.env_local/
__pypackages__/

# ── Python Bytecode & Caches ──────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
.Python

# ── Distribution / Packaging ─────────────────────────────────────────────────
dist/
build/
*.egg-info/
*.egg
.eggs/
MANIFEST

# ── Jupyter Notebooks ─────────────────────────────────────────────────────────
# Keep notebooks tracked but ignore checkpoint saves
.ipynb_checkpoints/
*/.ipynb_checkpoints/
# Uncomment below to strip outputs from notebooks before commit:
# *.ipynb

# ── Django ────────────────────────────────────────────────────────────────────
backend/db.sqlite3
backend/db.sqlite3-journal
backend/media/          # uploaded .mat files from clinicians (runtime)
backend/static/         # generated by collectstatic (runtime artefact)
!backend/static/.gitkeep

# ── Environment Variables / Secrets ──────────────────────────────────────────
.env
.env.*
!.env.example           # keep the example template

# ── Docker ────────────────────────────────────────────────────────────────────
# Docker named volumes are managed by Docker, not git
# (static_volume, media_volume, model_weights volumes)

# ── PyTorch / CUDA ────────────────────────────────────────────────────────────
*.pth
*.pt
*.ckpt
*.pkl
*.pickle

# ── Test & Coverage ───────────────────────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/
*.coveragerc
.tox/

# ── Linters / Formatters ──────────────────────────────────────────────────────
.mypy_cache/
.ruff_cache/
.pylint.d/

# ── IDEs ──────────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ── Logs ──────────────────────────────────────────────────────────────────────
*.log
logs/

# ── Matplotlib / Figure Outputs ───────────────────────────────────────────────
figures/
*.png
*.pdf
*.svg
# Exception: keep any static assets that are part of the frontend
!frontend/**/*.png
!frontend/**/*.svg

# ── Temporary Files ───────────────────────────────────────────────────────────
tmp/
temp/
*.tmp
*.bak
*.orig
